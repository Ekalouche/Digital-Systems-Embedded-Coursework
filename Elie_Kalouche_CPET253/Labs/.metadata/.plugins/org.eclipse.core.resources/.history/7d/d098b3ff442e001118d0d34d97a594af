#include "msp.h"
#include "msp.h"
#include <msp432.h>
#include <stdint.h>
#include <stdbool.h>
#include "../inc/Clock.h"
#include "../inc/CortexM.h"
#include "../inc/Init_Ports.h"
#include "../inc/Init_Timers.h"

void Servo(uint16_t angle_count);

void ServoInit(void)  // initializes servo to center position
{
    Servo(9000);              // center servo (1.5ms at 6MHz)
    Clock_Delay1ms(1000);     // wait for servo to reach center
    return;
}

void Servo(uint16_t angle_count)  // moves the servo
// input: angle_count in clock counts for desired pulse width
// Valid range at 6MHz (SMCLK/8):
//   6000  = 1.0ms = full left
//   9000  = 1.5ms = center
//   12000 = 2.0ms = full right
{
    TA3CCR0 = 119999;                           // 20ms period at 6MHz
    TA3CCR3 = angle_count;                      // set pulse width
    TA3CTL  = (TA3CTL & ~0x0030) | 0x0010;     // up mode, preserve clock bits
    return;
}

void main(void)
{
    WDT_A->CTL = WDT_A_CTL_PW | WDT_A_CTL_HOLD;   // stop watchdog timer
    Clock_Init48MHz();                               // 48MHz bus clock
    Port9_Init();                                    // init PWM pin P9.2
    TimerA3_Init();                                  // init Timer A3
    ServoInit();                                     // center servo
    uint16_t count;

    //Servo(7500);  // move to Full Right
   // Clock_Delay1ms(2000);
   // Servo(0);              // move to Center
    //Clock_Delay1ms(2000);     // wait 2 seconds
    // Servo(6000);              // move to Center


    while(1)
    {

        for(count = 0; count <= 15000; count += 500)
               {
                    Servo(count);
                    Clock_Delay1ms(1000);  // 1 second at each position
                    printf("Count: %d\r\n", count);
                }

    }                // hold position — keeps PWM signal alive
}
