LIBRARY ieee;
USE ieee.std_logic_1164.all;

ENTITY HW2 IS
PORT(A1,A0,B1,B0 :IN STD_LOGIC;
		GT :OUT STD_LOGIC;
		END HW2;
		
		ARCHITECTURE LogicFunction OF HW2 IS BEGIN
		GT <= (NOT A1 AND A0 AND NOT B1 AND NOT B0) + (A1 AND NOT A0 AND NOT B1 AND NOT B0) + (A1 AND NOT A0 AND NOT B1 AND B0) + (A1 AND A0 AND NOT B1 AND NOT B0) + ( A1 AND A0 NOT B1 AND B0) + (A1 AND A0 AND B1 AND NOT B0)
	END logicFunction;