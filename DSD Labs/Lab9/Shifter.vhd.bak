LIBRARY ieee;
USE ieee.std_logic_1164.all;
USE ieee.numeric_std.all;

ENTITY Shifter IS
    PORT (
        enable : IN  STD_LOGIC_VECTOR(25 downto 0);
        clk       : IN  STD_LOGIC;
        reset_n   : IN  STD_LOGIC;
        Hex0     : OUT STD_LOGIC_VECTOR(8 downto 0);
		  Hex1     : OUT STD_LOGIC_VECTOR(8 downto 0);
		  Hex2     : OUT STD_LOGIC_VECTOR(8 downto 0);
		  Hex3     : OUT STD_LOGIC_VECTOR(8 downto 0);
		  Hex4     : OUT STD_LOGIC_VECTOR(8 downto 0);
		  Hex5     : OUT STD_LOGIC_VECTOR(8 downto 0);
    );
END Shifter;

ARCHITECTURE LOGICFUNCTION OF Shifter IS
