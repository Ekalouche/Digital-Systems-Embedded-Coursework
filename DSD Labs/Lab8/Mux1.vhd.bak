LIBRARY ieee;
USE ieee.std_logic_1164.all;
USE ieee.numeric_std.all;  -- Needed for signed operations

ENTITY Mux IS
    PORT (
        S : IN STD_LOGIC_VECTOR(7 downto 0);
        max_value   : OUT STD_LOGIC_VECTOR(6 downto 0)
    );
END Mux;

ARCHITECTURE LOGICFUNCTION OF Sign_mux IS

    CONSTANT 100ms : STD_LOGIC_VECTOR(6 downto 0) := x"00063";  -- 8 bits
    CONSTANT 100ns  : STD_LOGIC_VECTOR(6 downto 0) := x"faf080";  -- 8 bits

BEGIN

    PROCESS(S)
    BEGIN
        IF S = '1' THEN  -- Check MSB for sign
            max_Value <= 100ms;
        ELSE
            max_Value <= 100ns;
        END IF;
    END PROCESS;

END LOGICFUNCTION;