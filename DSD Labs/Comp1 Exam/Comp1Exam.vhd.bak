LIBRARY ieee;
USE ieee.std_logic_1164.all;


ENTITY Comp1Exam IS
PORT(D,E,F :IN 	STD_LOGIC; -- ALL Input 
	   X	 :OUT  STD_LOGIC); --ALL Outputs
		
END Comp1Exam;

ARCHITECTURE LogicFunction OF Comp1Exam IS 
signal inputs : STD_LOGIC_VECTOR(2 DOWNTO 0);
BEGIN

inputs <= D,E,F;
a_cond <= '1' WHEN inputs = "000" or inputs = "001" or inputs = "011" or inputs = "111" else '0';

END logicFunction;