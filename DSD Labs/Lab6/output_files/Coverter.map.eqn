--A1L19 is Add0~1
A1L19_adder_eqn = ( inverted_bits[1] ) + ( inverted_bits[0] ) + ( !VCC );
A1L19 = SUM(A1L19_adder_eqn);

--A1L20 is Add0~2
A1L20_adder_eqn = ( inverted_bits[1] ) + ( inverted_bits[0] ) + ( !VCC );
A1L20 = CARRY(A1L20_adder_eqn);


--A1L23 is Add0~5
A1L23_adder_eqn = ( inverted_bits[2] ) + ( GND ) + ( A1L20 );
A1L23 = SUM(A1L23_adder_eqn);

--A1L24 is Add0~6
A1L24_adder_eqn = ( inverted_bits[2] ) + ( GND ) + ( A1L20 );
A1L24 = CARRY(A1L24_adder_eqn);


--A1L27 is Add0~9
A1L27_adder_eqn = ( inverted_bits[3] ) + ( GND ) + ( A1L24 );
A1L27 = SUM(A1L27_adder_eqn);

--A1L28 is Add0~10
A1L28_adder_eqn = ( inverted_bits[3] ) + ( GND ) + ( A1L24 );
A1L28 = CARRY(A1L28_adder_eqn);


--A1L31 is Add0~13
A1L31_adder_eqn = ( inverted_bits[4] ) + ( GND ) + ( A1L28 );
A1L31 = SUM(A1L31_adder_eqn);

--A1L32 is Add0~14
A1L32_adder_eqn = ( inverted_bits[4] ) + ( GND ) + ( A1L28 );
A1L32 = CARRY(A1L32_adder_eqn);


--A1L35 is Add0~17
A1L35_adder_eqn = ( inverted_bits[5] ) + ( GND ) + ( A1L32 );
A1L35 = SUM(A1L35_adder_eqn);

--A1L36 is Add0~18
A1L36_adder_eqn = ( inverted_bits[5] ) + ( GND ) + ( A1L32 );
A1L36 = CARRY(A1L36_adder_eqn);


--A1L39 is Add0~21
A1L39_adder_eqn = ( inverted_bits[6] ) + ( GND ) + ( A1L36 );
A1L39 = SUM(A1L39_adder_eqn);

--A1L40 is Add0~22
A1L40_adder_eqn = ( inverted_bits[6] ) + ( GND ) + ( A1L36 );
A1L40 = CARRY(A1L40_adder_eqn);


--A1L43 is Add0~25
A1L43_adder_eqn = ( GND ) + ( GND ) + ( A1L40 );
A1L43 = SUM(A1L43_adder_eqn);


--Abs_num[0] is Abs_num[0]
Abs_num[0] = OUTPUT(A1L10);


--Abs_num[1] is Abs_num[1]
Abs_num[1] = OUTPUT(A1L11);


--Abs_num[2] is Abs_num[2]
Abs_num[2] = OUTPUT(A1L12);


--Abs_num[3] is Abs_num[3]
Abs_num[3] = OUTPUT(A1L13);


--Abs_num[4] is Abs_num[4]
Abs_num[4] = OUTPUT(A1L14);


--Abs_num[5] is Abs_num[5]
Abs_num[5] = OUTPUT(A1L15);


--Abs_num[6] is Abs_num[6]
Abs_num[6] = OUTPUT(A1L16);


--Abs_num[7] is Abs_num[7]
Abs_num[7] = OUTPUT(A1L17);


--in_num[7] is in_num[7]
in_num[7] = INPUT();


--in_num[0] is in_num[0]
in_num[0] = INPUT();


--A1L10 is abs_val~0
A1L10 = (!in_num[7] & ((in_num[0]))) # (in_num[7] & (twos_comp[0]));


--in_num[1] is in_num[1]
in_num[1] = INPUT();


--A1L11 is abs_val~1
A1L11 = (!in_num[7] & ((in_num[1]))) # (in_num[7] & (twos_comp[1]));


--in_num[2] is in_num[2]
in_num[2] = INPUT();


--A1L12 is abs_val~2
A1L12 = (!in_num[7] & ((in_num[2]))) # (in_num[7] & (twos_comp[2]));


--in_num[3] is in_num[3]
in_num[3] = INPUT();


--A1L13 is abs_val~3
A1L13 = (!in_num[7] & ((in_num[3]))) # (in_num[7] & (twos_comp[3]));


--in_num[4] is in_num[4]
in_num[4] = INPUT();


--A1L14 is abs_val~4
A1L14 = (!in_num[7] & ((in_num[4]))) # (in_num[7] & (twos_comp[4]));


--in_num[5] is in_num[5]
in_num[5] = INPUT();


--A1L15 is abs_val~5
A1L15 = (!in_num[7] & ((in_num[5]))) # (in_num[7] & (twos_comp[5]));


--in_num[6] is in_num[6]
in_num[6] = INPUT();


--A1L16 is abs_val~6
A1L16 = (!in_num[7] & ((in_num[6]))) # (in_num[7] & (twos_comp[6]));


--A1L17 is abs_val~7
A1L17 = (in_num[7] & twos_comp[7]);


--twos_comp[0] is twos_comp[0]
twos_comp[0] = ( twos_comp[0] & ( in_num[7] & ( !inverted_bits[0] ) ) ) # ( !twos_comp[0] & ( in_num[7] & ( !inverted_bits[0] ) ) ) # ( twos_comp[0] & ( !in_num[7] ) );


--twos_comp[1] is twos_comp[1]
twos_comp[1] = ( twos_comp[1] & ( in_num[7] & ( A1L19 ) ) ) # ( !twos_comp[1] & ( in_num[7] & ( A1L19 ) ) ) # ( twos_comp[1] & ( !in_num[7] ) );


--twos_comp[2] is twos_comp[2]
twos_comp[2] = ( twos_comp[2] & ( in_num[7] & ( A1L23 ) ) ) # ( !twos_comp[2] & ( in_num[7] & ( A1L23 ) ) ) # ( twos_comp[2] & ( !in_num[7] ) );


--twos_comp[3] is twos_comp[3]
twos_comp[3] = ( twos_comp[3] & ( in_num[7] & ( A1L27 ) ) ) # ( !twos_comp[3] & ( in_num[7] & ( A1L27 ) ) ) # ( twos_comp[3] & ( !in_num[7] ) );


--twos_comp[4] is twos_comp[4]
twos_comp[4] = ( twos_comp[4] & ( in_num[7] & ( A1L31 ) ) ) # ( !twos_comp[4] & ( in_num[7] & ( A1L31 ) ) ) # ( twos_comp[4] & ( !in_num[7] ) );


--twos_comp[5] is twos_comp[5]
twos_comp[5] = ( twos_comp[5] & ( in_num[7] & ( A1L35 ) ) ) # ( !twos_comp[5] & ( in_num[7] & ( A1L35 ) ) ) # ( twos_comp[5] & ( !in_num[7] ) );


--twos_comp[6] is twos_comp[6]
twos_comp[6] = ( twos_comp[6] & ( in_num[7] & ( A1L39 ) ) ) # ( !twos_comp[6] & ( in_num[7] & ( A1L39 ) ) ) # ( twos_comp[6] & ( !in_num[7] ) );


--twos_comp[7] is twos_comp[7]
twos_comp[7] = ( twos_comp[7] & ( in_num[7] & ( A1L43 ) ) ) # ( !twos_comp[7] & ( in_num[7] & ( A1L43 ) ) ) # ( twos_comp[7] & ( !in_num[7] ) );


--inverted_bits[0] is inverted_bits[0]
inverted_bits[0] = ( inverted_bits[0] & ( in_num[7] & ( !in_num[0] ) ) ) # ( !inverted_bits[0] & ( in_num[7] & ( !in_num[0] ) ) ) # ( inverted_bits[0] & ( !in_num[7] ) );


--inverted_bits[1] is inverted_bits[1]
inverted_bits[1] = ( inverted_bits[1] & ( in_num[7] & ( !in_num[1] ) ) ) # ( !inverted_bits[1] & ( in_num[7] & ( !in_num[1] ) ) ) # ( inverted_bits[1] & ( !in_num[7] ) );


--inverted_bits[2] is inverted_bits[2]
inverted_bits[2] = ( inverted_bits[2] & ( in_num[7] & ( !in_num[2] ) ) ) # ( !inverted_bits[2] & ( in_num[7] & ( !in_num[2] ) ) ) # ( inverted_bits[2] & ( !in_num[7] ) );


--inverted_bits[3] is inverted_bits[3]
inverted_bits[3] = ( inverted_bits[3] & ( in_num[7] & ( !in_num[3] ) ) ) # ( !inverted_bits[3] & ( in_num[7] & ( !in_num[3] ) ) ) # ( inverted_bits[3] & ( !in_num[7] ) );


--inverted_bits[4] is inverted_bits[4]
inverted_bits[4] = ( inverted_bits[4] & ( in_num[7] & ( !in_num[4] ) ) ) # ( !inverted_bits[4] & ( in_num[7] & ( !in_num[4] ) ) ) # ( inverted_bits[4] & ( !in_num[7] ) );


--inverted_bits[5] is inverted_bits[5]
inverted_bits[5] = ( inverted_bits[5] & ( in_num[7] & ( !in_num[5] ) ) ) # ( !inverted_bits[5] & ( in_num[7] & ( !in_num[5] ) ) ) # ( inverted_bits[5] & ( !in_num[7] ) );


--inverted_bits[6] is inverted_bits[6]
inverted_bits[6] = ( inverted_bits[6] & ( in_num[7] & ( !in_num[6] ) ) ) # ( !inverted_bits[6] & ( in_num[7] & ( !in_num[6] ) ) ) # ( inverted_bits[6] & ( !in_num[7] ) );


