LIBRARY ieee;
USE ieee.std_logic_1164.all;

ENTITY birthday_f is
Port(W,X,Y,Z :IN	STD_LOGIC;
output_case: out STD_LOGIC_VECTOR(6 downto 0);

out_if: 	out STD_LOGIC_VECTOR(6 down 0);
END birthday_f;

ARCHITECTURE LOGICFUNCTION OF birthday_f is 
signal inputs : STD_LOGIC_VECTOR(3 DownTO 0);

constant SEG_0 : STD_LOGIC_VECTOR(6 downto 0) := "1000000";
	constant SEG_1 : STD_LOGIC_VECTOR(6 downto 0) := "1111001";
	constant SEG_2 : STD_LOGIC_VECTOR(6 downto 0) := "0100100";
	constant SEG_3 : STD_LOGIC_VECTOR(6 downto 0) := "0110000";
	constant SEG_4 : STD_LOGIC_VECTOR(6 downto 0) := "0011001";
	constant SEG_5 : STD_LOGIC_VECTOR(6 downto 0) := "0010010";
	constant SEG_6 : STD_LOGIC_VECTOR(6 downto 0) := "0000010";
	constant SEG_7 : STD_LOGIC_VECTOR(6 downto 0) := "1111000";
	constant SEG_8 : STD_LOGIC_VECTOR(6 downto 0) := "0000000";
	constant SEG_9 : STD_LOGIC_VECTOR(6 downto 0) := "0010000";
	constant BLANK : STD_LOGIC_VECTOR(6 downto 0) := "1111111";
	constant DASH : STD_LOGIC_VECTOR(6 downto 0) := "0111111";

	BEGIN
	inputs <= W & X & Y & Z;

PROCESS(inputs)
BEGIN
	CASE inputs IS
		WHEN "0000" => output_case <= SEG_0;
		WHEN "0001" => output_case <= SEG_9; 
		WHEN "0010" => output_case <= DASH;
		WHEN "0011" => output_case <= SEG_1;        
		WHEN "0100" => output_case <= SEG_8;
		WHEN "0101" => output_case <= DASH;
		WHEN "0110" => output_case <= SEG_2;
		WHEN "0111" => output_case <= SEG_0;          
		WHEN "1000" => output_case <= SEG_0;
		WHEN "1001" => output_case <= SEG_6;
		WHEN others => output_case <= BLANK;
	END CASE;
END PROCESS;

PROCESS(inputs)
BEGIN
      IF inputs = "0000" THEN
            output_if <= SEG_0;
      ELSIF inputs = "0001" THEN
            output_if <= SEG_9;
      ELSIF inputs = "0010" THEN
            output_if <= DASH;
      ELSIF inputs = "0011" THEN
            output_if <= SEG_1;
      ELSIF inputs = "0100" THEN
            output_if <= SEG_8;
      ELSIF inputs = "0101" THEN
            output_if <= DASH;
      ELSIF inputs = "0110" THEN
            output_if <= SEG_2;
      ELSIF inputs = "0111" THEN
            output_if <= SEG_0;
      ELSIF inputs = "1000" THEN
            output_if <= SEG_0;
      ELSIF inputs = "1001" THEN
            output_if <= SEG_6;
      ELSE
            output_if <= BLANK;
		END IF;
END PROCESS;
END test;