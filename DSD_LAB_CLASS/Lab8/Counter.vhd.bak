LIBRARY ieee;
USE ieee.std_logic_1164.all;

ENTITY counter IS
    PORT (
        set_n : IN STD_LOGIC_VECTOR(7 downto 0);
		  time : IN STD_Logic
		  enable : IN STD_Logic
		  reset_n : IN STD_Logic
		  clk : IN STD_Logic
        count  : OUT STD_LOGIC_VECTOR(6 downto 0);
    );
END counter;

ARCHITECTURE LOGICFUNCTION OF counter IS

		CONSTANT Nines : unsigned(9 downto 0) := "1111100111"
	
		signal inside_count : unsigned( 9 downto 0);
	 
	begin 
			process (clk is
			begin
				if(rising_edge(clk)) than
						if reset_n = '0'
							inside_count <= (others => '0');
						elsif (set_n = '0') then
							inside_count <= unsigned(time);
						elsif (enable = '1') then
						if (inside_count >= Nines) then
        inside_count <= (others => '0');
						else
     inside_count <= inside_count + "0000000001";
				end if;
			end if;
		end if;
  end process;

		count <= std_logic_vector(inside_count);
		
	end LOGICFUNCTION;
											