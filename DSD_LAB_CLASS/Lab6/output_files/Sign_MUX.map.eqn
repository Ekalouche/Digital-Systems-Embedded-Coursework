--in_num[0] is in_num[0]
in_num[0] = INPUT();


--in_num[1] is in_num[1]
in_num[1] = INPUT();


--in_num[2] is in_num[2]
in_num[2] = INPUT();


--in_num[3] is in_num[3]
in_num[3] = INPUT();


--in_num[4] is in_num[4]
in_num[4] = INPUT();


--in_num[5] is in_num[5]
in_num[5] = INPUT();


--in_num[6] is in_num[6]
in_num[6] = INPUT();


--HEX3[0] is HEX3[0]
HEX3[0] = OUTPUT(A1L20);


--HEX3[1] is HEX3[1]
HEX3[1] = OUTPUT(A1L20);


--HEX3[2] is HEX3[2]
HEX3[2] = OUTPUT(A1L20);


--HEX3[3] is HEX3[3]
HEX3[3] = OUTPUT(A1L20);


--HEX3[4] is HEX3[4]
HEX3[4] = OUTPUT(A1L20);


--HEX3[5] is HEX3[5]
HEX3[5] = OUTPUT(A1L20);


--HEX3[6] is HEX3[6]
HEX3[6] = OUTPUT(A1L20);


--HEX3[7] is HEX3[7]
HEX3[7] = OUTPUT(A1L19);


--in_num[7] is in_num[7]
in_num[7] = INPUT();


--A1L20 is ~VCC
A1L20 = VCC;


--A1L19 is in_num[7]~_wirecell
A1L19 = !in_num[7];


